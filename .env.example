# ── Application ─────────────────────────────────────────────────────────────────
APP_NAME="URL Shortener"
APP_VERSION="1.0.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
SECRET_KEY="change-me-to-a-long-random-secret-key"
ALLOWED_HOSTS="*"
BASE_URL="http://localhost:8000"

# ── JWT / Auth ─────────────────────────────────────────────────────────────
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API ──────────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"
DOCS_URL="/docs"
REDOC_URL="/redoc"

# ── Short URL ───────────────────────────────────────────────────────────────────
SHORT_CODE_LENGTH=7             # characters in generated short code
MAX_CUSTOM_ALIAS_LENGTH=50

# ── PostgreSQL ───────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ── Connection Pool ──────────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"
CACHE_TTL_SECONDS=1800         # 30 minutes cache TTL

# ── Rate Limiting ────────────────────────────────────────────────────────────────
RATE_LIMIT_ANON_REQUESTS=50
RATE_LIMIT_AUTH_REQUESTS=500
RATE_LIMIT_WINDOW_SECONDS=3600

# ── CORS ─────────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
CORS_ALLOW_CREDENTIALS=true

# ── Logging ──────────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"              # json | console
